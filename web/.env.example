# ========================================
# AI Provider Configuration
# ========================================

# 使用するAIプロバイダーを選択（デフォルト: openai）
# 選択肢: openai, deepseek, claude, gemini
AI_PROVIDER=openai

# ----------------------------------------
# OpenAI (GPT-4o-mini)
# ----------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----------------------------------------
# DeepSeek (DeepSeek V3) - 最もコスト効率が良い
# ----------------------------------------
# https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ----------------------------------------
# Anthropic Claude (Claude 3.5 Haiku)
# ----------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ----------------------------------------
# Google Gemini (Gemini 1.5 Flash)
# ----------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ========================================
# 注意事項
# ========================================
# 1. .env.local ファイルを作成して、実際のAPIキーを設定してください
# 2. .env.local は .gitignore に含まれているため、GitHubにコミットされません
# 3. 使用するプロバイダーのAPIキーのみ設定すれば動作します
# 4. APIキーが未設定の場合、フォールバックメッセージが表示されます
