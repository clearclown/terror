# ========================================
# Server Configuration
# ========================================

# サーバーのホストアドレス（デフォルト: 0.0.0.0）
# 0.0.0.0 に設定すると、すべてのネットワークインターフェースでリッスンします（VPN経由でのアクセスが可能）
# localhost または 127.0.0.1 に設定すると、ローカルホストのみでアクセス可能
HOST=0.0.0.0

# サーバーのポート番号（デフォルト: 3005）
# ポート競合がある場合は、別のポート番号を指定してください
PORT=3005

# ========================================
# AI Provider Configuration
# ========================================

# 使用するAIプロバイダーを選択（デフォルト: openai）
# 選択肢: openai, deepseek, claude, gemini
AI_PROVIDER=openai

# ----------------------------------------
# OpenAI (GPT-4o-mini)
# ----------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----------------------------------------
# DeepSeek (DeepSeek V3) - 最もコスト効率が良い
# ----------------------------------------
# https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ----------------------------------------
# Anthropic Claude (Claude 3.5 Haiku)
# ----------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ----------------------------------------
# Google Gemini (Gemini 1.5 Flash)
# ----------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ========================================
# 注意事項
# ========================================
# 1. このファイルを .env にコピーして、実際のAPIキーを設定してください
#    cp .env.example .env
# 2. .env ファイルは .gitignore に含まれているため、GitHubにコミットされません
# 3. 使用するプロバイダーのAPIキーのみ設定すれば動作します
# 4. APIキーが未設定の場合、フォールバックメッセージが表示されます
# 5. 機密情報（APIキー）は .env ファイルにのみ記述してください
